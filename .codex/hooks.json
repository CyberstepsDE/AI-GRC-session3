{
  "description": "Project guardrails for Codex. Codex runs project hooks only after you trust them once with /hooks (again after a hook changes).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$(git rev-parse --show-toplevel)/.claude/hooks/critical-thinking-reminder.sh\"",
            "commandWindows": "git -c \"alias.critical-thinking-reminder=!sh .claude/hooks/critical-thinking-reminder.sh\" critical-thinking-reminder",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
